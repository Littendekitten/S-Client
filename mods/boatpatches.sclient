{
  "format": "sclient-mod",
  "formatVersion": 2,
  "language": "SCL",
  "languageVersion": 1,
  "id": "boatpatches",
  "name": "BoatPatches",
  "version": "1.0.0",
  "author": "KitaCat",
  "game": "aquavoid",
  "gameVersion": "1.0",
  "gameVersions": [
    "1.0",
    "1.01"
  ],
  "description": "Every boat model's sail faces the right way, billowing toward the bow.",
  "icon": "⛵",
  "permissions": [
    "vehicles.sailFix"
  ],
  "program": {
    "onInstall": [
      {
        "op": "toast",
        "message": "BoatPatches installed. Enable it for an instance to fix the boat sails."
      }
    ]
  }
}
